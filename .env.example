# Resend (https://resend.com). Leave empty to run the forms in demo mode.
RESEND_API_KEY=
# Where reservation and corporate inquiries are sent.
INQUIRY_TO_EMAIL=themessykitchenph@gmail.com
# Optional sender, e.g. "The Messy Kitchen <orders@yourdomain.ph>" (domain must be verified in Resend).
RESEND_FROM=
# Optional: overrides SITE.url in src/config/site.ts for canonical URLs and the sitemap.
SITE_URL=
