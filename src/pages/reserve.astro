---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FormShell from '../components/FormShell.astro';
import Field from '../components/Field.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config/site';
import { branches } from '../data/branches';
import { formatPrice, reservableCakes } from '../data/menu';
import { SUCCESS } from '../lib/inquiry';
import { addDays, manilaToday } from '../lib/time';

const cakes = reservableCakes();
const { minLeadDays, maxLeadDays, maxQuantity, dedicationMaxLength } = SITE.reservation;
// Build-time fallback; the form script recalculates these in the visitor's browser.
const today = manilaToday();
const minDate = addDays(today, minLeadDays);
const maxDate = addDays(today, maxLeadDays);

const steps = [
  { icon: 'cake' as const, title: 'Pick your cake', text: `Choose a cake, a branch and a pickup date at least ${minLeadDays} days away.` },
  { icon: 'chat' as const, title: 'We text you', text: 'We confirm your reservation and send payment details by text.' },
  { icon: 'bag' as const, title: 'Pick it up', text: 'Drop by the branch on your date. Your cake will be ready.' },
];
---

<BaseLayout
  title="Cake Reservation in CDO | Reserve a Tres Leches Cake"
  description={`Reserve a Cookie Butter Tres Leches or Ube Cake online for pickup in Nazareth, Ayala Centrio or Kauswagan, Cagayan de Oro. Order at least ${minLeadDays} days ahead.`}
  ogImage="/og/reserve.png"
  crumbs={[{ name: 'Reserve a Cake', path: '/reserve/' }]}
>
  <section class="container-site grid gap-12 pt-8 md:pt-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <SectionHeader as="h1" eyebrow="Pickup at any branch" title="Reserve a Cake">
        <p>
          Not a checkout, just a request. Tell us what you'd like and we'll text you to confirm. Nothing is charged here.
        </p>
      </SectionHeader>

      <ol class="mt-10 space-y-6">
        {
          steps.map((s, i) => (
            <li class="flex gap-4">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-cream">
                <Icon name={s.icon} class="h-6 w-6" />
              </span>
              <div>
                <h2 class="font-display text-[0.9375rem] tracking-[0.14em] uppercase">
                  <span class="text-muted">0{i + 1} · </span>
                  {s.title}
                </h2>
                <p class="mt-1 text-[1rem] text-muted">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="accent-cookie mt-10 rounded-[var(--radius-card)] bg-[var(--accent-wash)] p-6">
        <p class="eyebrow !text-[var(--accent-deep)]">Good to know</p>
        <ul class="mt-3 space-y-2 text-[1rem]">
          <li>Order at least {minLeadDays} days before pickup.</li>
          <li>Add a short dedication, up to {dedicationMaxLength} characters.</li>
          <li>
            Need it sooner, or a big batch? <a href={SITE.social.messenger} class="link" target="_blank" rel="noopener"
              >Message us</a
            > or see <a href="/celebrations/" class="link">Celebrations & Corporate</a>.
          </li>
        </ul>
      </div>
    </div>

    <div class="lg:col-span-7">
      <FormShell type="reservation" label="Cake reservation" submitLabel="Send reservation" successMessage={SUCCESS.reservation}>
        <fieldset class="grid gap-6">
          <legend class="eyebrow mb-5 !text-ink">Your cake</legend>
          <Field label="Cake" name="cake">
            <select id="f-cake" name="cake" class="field" required data-msg="Please choose a cake." aria-describedby="f-cake-error">
              <option value="">Choose a cake</option>
              {
                cakes.map((c) => (
                  <option value={c.id}>
                    {c.name}
                    {c.price != null ? ` · ${formatPrice(c.price)}` : ''}
                  </option>
                ))
              }
            </select>
          </Field>

          <div class="grid gap-6 sm:grid-cols-[8rem_1fr]">
            <Field label="Quantity" name="quantity">
              <input
                id="f-quantity"
                name="quantity"
                type="number"
                inputmode="numeric"
                min="1"
                max={maxQuantity}
                value="1"
                required
                class="field"
                data-msg={`Please enter 1 to ${maxQuantity}.`}
                aria-describedby="f-quantity-error"
              />
            </Field>
            <Field label="Pickup branch" name="branch">
              <select id="f-branch" name="branch" class="field" required data-msg="Please choose a pickup branch." aria-describedby="f-branch-error">
                <option value="">Choose a branch</option>
                {branches.map((b) => <option value={b.slug}>{b.name}</option>)}
              </select>
            </Field>
          </div>

          <Field label="Pickup date" name="date" hint={`At least ${minLeadDays} days from today. Branches are open ${SITE.hours.short}.`}>
            <input
              id="f-date"
              name="date"
              type="date"
              required
              min={minDate}
              max={maxDate}
              data-min-lead={minLeadDays}
              data-max-lead={maxLeadDays}
              class="field"
              data-msg={`Please choose a date at least ${minLeadDays} days from today.`}
              aria-describedby="f-date-hint f-date-error"
            />
          </Field>

          <Field label="Dedication" name="dedication" optional hint="Short and sweet, e.g. “Happy birthday, Ma!”">
            <div class="relative">
              <input
                id="f-dedication"
                name="dedication"
                type="text"
                maxlength={dedicationMaxLength}
                class="field pr-16"
                data-counter
                aria-describedby="f-dedication-hint f-dedication-error f-dedication-count"
              />
              <span
                id="f-dedication-count"
                data-count-for="dedication"
                class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 font-display text-xs tracking-wider text-muted"
                aria-live="polite">0/{dedicationMaxLength}</span
              >
            </div>
          </Field>
        </fieldset>

        <div class="h-px bg-ink/10" aria-hidden="true"></div>
        <fieldset class="grid gap-6">
          <legend class="eyebrow mb-5 !text-ink">Your details</legend>
          <Field label="Name" name="name">
            <input id="f-name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="80" class="field" data-msg="Please enter your name." aria-describedby="f-name-error" />
          </Field>
          <div class="grid gap-6 sm:grid-cols-2">
            <Field label="Mobile" name="mobile" hint="We'll text you here. Format: 09XXXXXXXXX">
              <input
                id="f-mobile"
                name="mobile"
                type="tel"
                inputmode="tel"
                autocomplete="tel-national"
                required
                pattern="^(\+?63|0)9[0-9]{2}[\s\-]?[0-9]{3}[\s\-]?[0-9]{4}$"
                maxlength="16"
                class="field"
                placeholder="09171234567"
                data-msg="Please enter a PH mobile number like 09171234567."
                aria-describedby="f-mobile-hint f-mobile-error"
              />
            </Field>
            <Field label="Email" name="email" optional>
              <input id="f-email" name="email" type="email" autocomplete="email" maxlength="120" class="field" data-msg="That email doesn’t look right." aria-describedby="f-email-error" />
            </Field>
          </div>
          <Field label="Notes" name="notes" optional hint="Pickup time, allergies, anything we should know.">
            <textarea id="f-notes" name="notes" rows="3" maxlength="1000" class="field" aria-describedby="f-notes-hint f-notes-error"></textarea>
          </Field>
        </fieldset>
      </FormShell>
    </div>
  </section>
</BaseLayout>
