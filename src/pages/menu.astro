---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import MenuItemCard from '../components/MenuItemCard.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config/site';
import { categories, itemsIn } from '../data/menu';
import { menuSchema } from '../lib/schema';

const site = Astro.site!;
---

<BaseLayout
  title="Menu: Tres Leches & Matcha Café in CDO | Messy Kitchen"
  description="The Messy Kitchen menu: tres leches cakes, cookies, coffee, matcha and Cookie Butter Soft Serve in Cagayan de Oro. See prices and which branch has what."
  ogImage="/og/menu.png"
  crumbs={[{ name: 'Menu', path: '/menu/' }]}
  schema={[menuSchema(site)]}
>
  <section class="container-site pt-8 md:pt-12">
    <SectionHeader as="h1" eyebrow="What we bake" title="Menu">
      <p>
        Cakes, cookies, coffee and matcha, all made in our kitchen. Whole cakes can be reserved ahead for pickup at any
        branch.
      </p>
    </SectionHeader>
  </section>

  <!-- Category filter. Without JavaScript every category simply stays visible. -->
  <div class="sticky top-16 z-30 mt-10 border-y border-ink/10 bg-paper/95 backdrop-blur-md md:top-[4.5rem]">
    <div class="container-site">
      <ul class="no-scrollbar -mx-1 flex gap-2 overflow-x-auto px-1 py-3" aria-label="Filter the menu by category" data-filter-bar>
        <li>
          <button type="button" class="chip" data-filter="all" aria-pressed="true">All</button>
        </li>
        {
          categories.map((c) => (
            <li>
              <button type="button" class="chip" data-filter={c.id} aria-pressed="false">
                {c.label}
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container-site">
    {
      categories.map((c) => (
        <section id={c.id} class="scroll-mt-40 pt-14" data-category={c.id} aria-labelledby={`${c.id}-title`}>
          <div class="flex items-center gap-4">
            <Icon name={c.icon} class="h-10 w-10 shrink-0" strokeWidth={1.1} />
            <div>
              <h2 id={`${c.id}-title`} class="display-3">
                {c.label}
              </h2>
              <p class="text-[1rem] text-muted">{c.blurb}</p>
            </div>
          </div>
          <ul class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {itemsIn(c.id).map((item) => (
              <li>
                <MenuItemCard item={item} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <p class="mt-14 max-w-2xl text-[1rem] text-muted">
      Prices and availability can change by branch and season. For the latest, send us a message on{' '}
      <a href={SITE.social.messenger} class="link text-ink" target="_blank" rel="noopener">Messenger</a> or ask at the counter.
    </p>

    <aside class="accent-ube mt-10 flex flex-col items-start gap-5 rounded-[var(--radius-card)] bg-[var(--accent-wash)] p-7 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-4">
        <Icon name="gift" class="h-10 w-10 shrink-0 text-[var(--accent-deep)]" />
        <div>
          <h2 class="display-3">Ordering for a crowd?</h2>
          <p class="text-[1rem] text-muted">Cookie boxes, cake bundles and office pantry orders.</p>
        </div>
      </div>
      <a href="/celebrations/" class="btn btn-ghost btn-sm shrink-0">Celebrations & Corporate</a>
    </aside>
  </div>
</BaseLayout>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.4rem 1rem;
    border: 1px solid rgb(26 26 26 / 0.2);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
    cursor: pointer;
  }
  .chip:hover {
    border-color: var(--color-ink);
  }
  .chip[aria-pressed='true'] {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }
</style>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-category]')];
  const ids = sections.map((s) => s.dataset.category!);

  function apply(filter: string, updateUrl = true) {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
    sections.forEach((s) => (s.hidden = filter !== 'all' && s.dataset.category !== filter));
    if (updateUrl) history.replaceState(null, '', filter === 'all' ? location.pathname : `#${filter}`);
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      apply(b.dataset.filter!);
      b.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
    }),
  );

  // Deep links: /menu/#cookies filters, /menu/#some-item-id scrolls to that item.
  const hash = decodeURIComponent(location.hash.slice(1));
  if (ids.includes(hash)) {
    apply(hash, false);
    document.getElementById(hash)?.scrollIntoView();
  }
</script>
