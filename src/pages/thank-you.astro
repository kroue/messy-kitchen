---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config/site';
import { SUCCESS } from '../lib/inquiry';
// Landing page for form submissions made without JavaScript.
---

<BaseLayout title="Thank You | The Messy Kitchen" description="Thanks for reaching out to The Messy Kitchen." noindex>
  <section class="container-site flex flex-col items-center py-20 text-center md:py-28">
    <span class="grid h-20 w-20 place-items-center rounded-full bg-matcha-wash text-matcha-deep">
      <Icon name="check" class="h-10 w-10" />
    </span>
    <h1 class="display-2 mt-8 max-w-xl" data-thanks data-corporate={SUCCESS.corporate}>{SUCCESS.reservation}</h1>
    <p class="lede mt-5 max-w-md">
      Questions in the meantime? <a href={SITE.social.messenger} class="link text-ink" target="_blank" rel="noopener">Message us on Messenger</a>.
    </p>
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="btn btn-primary">Back home</a>
      <a href="/menu/" class="btn btn-ghost">See the menu</a>
    </div>
  </section>
</BaseLayout>

<script>
  if (new URLSearchParams(location.search).get('type') === 'corporate') {
    const h = document.querySelector<HTMLElement>('[data-thanks]');
    if (h) h.textContent = h.dataset.corporate!;
  }
</script>
