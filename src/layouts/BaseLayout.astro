---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { DEMO_MODE, SITE } from '../config/site';
import { abs, breadcrumbList, organization, type Crumb } from '../lib/schema';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import DemoBadge from '../components/DemoBadge.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
  /** Full <title>. Keep it under ~60 characters. */
  title: string;
  description: string;
  /** Path of an image in /public, e.g. "/og/menu.png". */
  ogImage?: string;
  ogImageAlt?: string;
  /** Breadcrumbs after "Home". Adds BreadcrumbList JSON-LD and a visible trail. */
  crumbs?: Crumb[];
  /** Extra JSON-LD nodes for this page. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = '/og/default.png',
  ogImageAlt = `${SITE.name}, ${SITE.tagline}`,
  crumbs,
  schema = [],
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL(SITE.url);
const canonical = abs(site, Astro.url.pathname);
const robots = DEMO_MODE || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const trail: Crumb[] | undefined = crumbs ? [{ name: 'Home', path: '/' }, ...crumbs] : undefined;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    organization(site),
    {
      '@type': 'WebSite',
      '@id': abs(site, '/#website'),
      name: SITE.name,
      url: abs(site, '/'),
      inLanguage: SITE.lang,
      publisher: { '@id': abs(site, '/#organization') },
    },
    ...schema,
    ...(trail ? [breadcrumbList(site, trail)] : []),
  ],
};
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#FBF8F3" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(site, ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(site, ogImage)} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <Font cssVariable="--font-jost" preload />
    <Font cssVariable="--font-newsreader" preload={[{ weight: '400', style: 'normal' }]} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body class="flex min-h-dvh flex-col pb-[calc(4.5rem+env(safe-area-inset-bottom))] md:pb-0">
    <a
      href="#main"
      class="btn btn-primary btn-sm fixed top-3 left-3 z-[60] -translate-y-24 focus-visible:translate-y-0"
      >Skip to content</a
    >
    {DEMO_MODE && <DemoBadge />}
    <Header />
    <main id="main" class="flex-1">
      {trail && <Breadcrumbs crumbs={trail} />}
      <slot />
    </main>
    <Footer />
    <MobileBar />
  </body>
</html>
