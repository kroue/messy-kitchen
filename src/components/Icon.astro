---
import { ICONS, type IconName } from './icons';

interface Props extends Omit<astroHTML.JSX.SVGAttributes, 'name'> {
  name: IconName;
  /** Accessible label. Without it the icon is decorative. */
  label?: string;
  strokeWidth?: number;
}

const { name, label, strokeWidth = 1.5, ...rest } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  {...rest}
  set:html={ICONS[name]}
/>
