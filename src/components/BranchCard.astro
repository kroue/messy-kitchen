---
import { directionsUrl, telUrl, type Branch } from '../data/branches';
import Icon from './Icon.astro';
import OpenStatus from './OpenStatus.astro';

interface Props {
  branch: Branch;
  headingLevel?: 'h2' | 'h3';
}
const { branch: b, headingLevel: H = 'h3' } = Astro.props;
---

<article class:list={['card lift relative flex h-full flex-col border border-ink/10 p-6 sm:p-7', `accent-${b.accent}`]}>
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="eyebrow">{b.kind}</p>
      <H class="display-3 mt-2">
        <a href={`/branches/${b.slug}/`} class="after:absolute after:inset-0 hover:underline">{b.name}</a>
      </H>
    </div>
    <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-[var(--accent-wash)] text-[var(--accent-deep)]">
      <Icon name="pin" class="h-6 w-6" />
    </span>
  </div>
  <p class="mt-4 text-muted">{b.blurb}</p>
  <dl class="mt-5 space-y-2 text-[0.9375rem]">
    <div class="flex gap-3">
      <dt class="sr-only">Address</dt>
      <Icon name="building" class="mt-1 h-4 w-4 shrink-0 text-muted" />
      <dd>{b.street}</dd>
    </div>
    <div class="flex gap-3">
      <dt class="sr-only">Hours</dt>
      <Icon name="clock" class="mt-1 h-4 w-4 shrink-0 text-muted" />
      <dd>{b.hoursLabel}</dd>
    </div>
  </dl>
  <div class="mt-4"><OpenStatus branch={b} /></div>
  <div class="relative z-10 mt-auto flex flex-wrap gap-2 pt-6">
    <a href={directionsUrl(b)} class="btn btn-ghost btn-sm" target="_blank" rel="noopener">
      <Icon name="pin" /> Directions<span class="sr-only"> to {b.name}</span>
    </a>
    <a href={telUrl(b)} class="btn btn-ghost btn-sm">
      <Icon name="phone" /> Call<span class="sr-only"> {b.name}, {b.phone}</span>
    </a>
  </div>
</article>
